---
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import BeeRail from '../../../components/BeeRail.astro';
import News from '../../../components/News.astro';
import Footer from '../../../components/Footer.astro';
import { LOCALES, getHome, getNews, type Locale } from '../../../lib/site';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const [home, news] = await Promise.all([getHome(lang), getNews(lang)]);
---
<Base lang={lang} title={`${home.news.title} — Aum Aurum`} description={home.meta.description} path="news/">
  <Header lang={lang} nav={home.nav} ui={home.ui} path="news/" home={false} />
  <BeeRail />
  <main class="page">
    <News lang={lang} title={home.news.title} items={news} ui={home.ui} full />
  </main>
  <Footer lang={lang} text={home.footer.text} links={[]} comingSoon={home.ui.coming_soon} />
</Base>

<style>
  .page { min-height: calc(100svh - var(--header-h) - 120px); background: var(--paper); }
</style>
