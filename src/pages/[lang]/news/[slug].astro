---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Header from '../../../components/Header.astro';
import BeeRail from '../../../components/BeeRail.astro';
import Footer from '../../../components/Footer.astro';
import { LOCALES, getHome, getNews, url, type Locale } from '../../../lib/site';

export async function getStaticPaths() {
  const paths = [];
  for (const lang of LOCALES) {
    for (const post of await getNews(lang)) paths.push({ params: { lang, slug: post.slug }, props: { post } });
  }
  return paths;
}

const lang = Astro.params.lang as Locale;
const { post } = Astro.props;
const home = await getHome(lang);
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric' });
---
<Base lang={lang} title={`${post.data.title} — Aum Aurum`} description={post.data.excerpt} path={`news/${post.slug}/`}>
  <Header lang={lang} nav={home.nav} ui={home.ui} path={`news/${post.slug}/`} home={false} />
  <BeeRail />
  <main class="section paper page">
    <article class="wrap post">
      <a class="back" href={url(`/${lang}/news/`)}>← {home.ui.all_news}</a>
      <div class="meta">
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{date}</time>
        {post.data.example && <span class="tag">{home.ui.placeholder_note}</span>}
      </div>
      <h1>{post.data.title}</h1>
      {post.data.image && <img class="cover" src={url(post.data.image)} alt={post.data.title} />}
      <div class="body"><Content /></div>
    </article>
  </main>
  <Footer lang={lang} text={home.footer.text} links={[]} comingSoon={home.ui.coming_soon} />
</Base>

<style>
  .page { min-height: calc(100svh - var(--header-h) - 120px); }
  .post { max-width: 900px; }
  .back { color: var(--wine); font-size: 15px; }
  .meta { display: flex; gap: 0.75rem; align-items: center; margin: 2rem 0 1rem; }
  time { color: var(--wine); font: 400 17px var(--display); letter-spacing: 0.08em; }
  h1 { font: 400 clamp(2.4rem, 1.5rem + 3.5vw, 4.5rem)/1.05 var(--display); text-wrap: balance; }
  .cover { margin-top: 2.5rem; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .body { margin-top: 2rem; max-width: 65ch; font-size: 1.15rem; line-height: 1.7; }
  .body :global(p + p) { margin-top: 1em; }
</style>
