---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import BeeRail from '../../components/BeeRail.astro';
import Home from '../../components/Home.astro';
import Shop from '../../components/Shop.astro';
import Location from '../../components/Location.astro';
import News from '../../components/News.astro';
import Reviews from '../../components/Reviews.astro';
import Gallery from '../../components/Gallery.astro';
import Footer from '../../components/Footer.astro';
import { LOCALES, getHome, getProducts, getNews, getSettings, channelLink, type Locale } from '../../lib/site';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const [home, products, news, { site, reviews }] = await Promise.all([
  getHome(lang), getProducts(lang), getNews(lang), getSettings(),
]);

const orderHref = channelLink(site, 'whatsapp', home.ui.order_message)?.href ?? '#contact';
const footerLinks = [
  channelLink(site, 'whatsapp'),
  channelLink(site, 'telegram'),
  channelLink(site, 'phone'),
  channelLink(site, 'email'),
  site.facebook ? { href: site.facebook, label: 'Facebook' } : null,
  site.instagram ? { href: site.instagram, label: 'Instagram' } : null,
].filter(Boolean) as { href: string; label: string }[];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Aum Aurum',
  description: home.meta.description,
  address: { '@type': 'PostalAddress', addressLocality: 'Navazi', addressRegion: 'Mtskheta-Mtianeti', addressCountry: 'GE' },
  geo: { '@type': 'GeoCoordinates', latitude: site.lat, longitude: site.lng },
  ...(site.phone ? { telephone: site.phone } : {}),
};
---
<Base lang={lang} title={home.meta.title} description={home.meta.description} jsonLd={jsonLd}>
  <Header lang={lang} nav={home.nav} ui={home.ui} />
  <BeeRail />
  <main>
    <Home hero={home.hero} story={home.story} orderHref={orderHref} />
    <Shop shop={home.shop} products={products} ui={home.ui} orderHref={orderHref} contactHref="#contact" />
    <Location location={home.location} lat={site.lat} lng={site.lng} />
    <News lang={lang} title={home.news.title} items={news} ui={home.ui} />
    <Reviews reviews={home.reviews} items={reviews} />
    <Gallery gallery={home.gallery} photoSoon={home.ui.photo_soon} />
  </main>
  <Footer lang={lang} text={home.footer.text} links={footerLinks} comingSoon={home.ui.coming_soon} />
</Base>
