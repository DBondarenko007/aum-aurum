---
// All products on one page, no carousels: honey, bee colonies, hives, other. Empty groups are hidden.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import HoneyFrame from '../../components/HoneyFrame.astro';
import HiveCard from '../../components/HiveCard.astro';
import FloatingContact from '../../components/FloatingContact.astro';
import { LOCALES, getHome, getProducts, getSettings, messageLink, url, type Locale, type ProductEntry } from '../../lib/site';

export function getStaticPaths() {
  return LOCALES.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const [home, products, { site }] = await Promise.all([getHome(lang), getProducts(lang), getSettings()]);
const shop = home.shop;
const labels = { ...shop, price_on_request: home.ui.price_on_request, photo_soon: home.ui.photo_soon };
const contactHref = url(`/${lang}/#contact`);
const msg = (p: ProductEntry) => messageLink(site, `${shop.message} ${p.data.title}`, contactHref);
const groups = (['honey', 'colonies', 'hives', 'other'] as const)
  .map((cat) => ({ cat, items: products.filter((p) => p.data.available && p.data.category === cat) }))
  .filter((g) => g.items.length > 0);
---
<Base lang={lang} title={`${shop.page_title} — Aum Aurum`} description={home.meta.description} path="shop/">
  <Header lang={lang} nav={home.nav} ui={home.ui} path="shop/" home={false} />
  <main class="section paper page">
    <div class="wrap">
      <a class="back" href={url(`/${lang}/#shop`)}>← {home.ui.back}</a>
      <div class="top">
        <h1>{shop.page_title}</h1>
        <p>{shop.page_text}</p>
      </div>
      {groups.length > 1 && (
        <nav class="jump" aria-label={shop.page_title}>
          {groups.map((g) => <a href={`#${g.cat}`}>{shop.categories[g.cat]}</a>)}
        </nav>
      )}
      {groups.map((g) => (
        <section class="group" id={g.cat} aria-labelledby={`h-${g.cat}`}>
          <h2 id={`h-${g.cat}`} class:list={['cat', g.cat]}><i aria-hidden="true"></i>{shop.categories[g.cat]}</h2>
          <div class:list={['grid', { frames: g.cat === 'honey' }]}>
            {g.items.map((p) => g.cat === 'honey'
              ? <HoneyFrame product={p} lang={lang} labels={labels} />
              : <HiveCard product={p} lang={lang} labels={labels} message={msg(p)} />)}
          </div>
        </section>
      ))}
    </div>
  </main>
  <Footer lang={lang} text={home.footer.text} links={[]} comingSoon={home.ui.coming_soon} privacyLabel={home.ui.privacy} />
  <FloatingContact whatsapp={site.whatsapp} telegram={site.telegram} label={home.ui.contact_us} />
</Base>

<script>
  import '../../scripts/add-buttons';
</script>

<style>
  .back { color: var(--wine); font-size: 15px; }
  .top { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem 3rem; margin: 1.5rem 0 2rem; }
  h1 { font: 400 clamp(2.6rem, 1.6rem + 4vw, 4.75rem)/1.04 var(--display); }
  .top p { max-width: 38ch; color: var(--ink-soft); }
  .jump { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; padding: 1rem 0; border-block: 1px solid rgb(20 17 14 / 0.15); margin-bottom: 1rem; }
  .jump a { font: 400 16px var(--display); letter-spacing: var(--track); text-transform: uppercase; color: var(--soot); text-decoration: none; }
  :lang(ka) .jump a { text-transform: none; }
  .jump a:hover { color: var(--wine); }
  .group { padding-top: clamp(2.5rem, 2rem + 2vw, 3.5rem); scroll-margin-top: var(--header-h); }
  .cat { display: flex; align-items: center; gap: 0.8rem; font-size: clamp(2rem, 1.4rem + 2vw, 3rem); margin-bottom: 2rem; }
  .cat i { width: 16px; height: 16px; background: var(--gold-deep); clip-path: polygon(25% 0, 75% 0, 100% 50%, 75% 100%, 25% 100%, 0 50%); }
  .cat.colonies i { background: var(--olive); }
  .cat.hives i { background: var(--wine); }
  .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(2rem, 3vw, 2.5rem) clamp(1.25rem, 2.5vw, 2.25rem); padding-top: 14px; }
  @media (max-width: 1100px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .grid { grid-template-columns: 1fr; } }
</style>
