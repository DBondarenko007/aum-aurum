---
import { url } from '../../lib/site';
// Sveltia CMS admin. Reads /admin/config.yml (public/admin/config.yml).
// polyfills.js runs first so the admin also works in older Safari / iPad browsers.
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Aum Aurum — админка</title>
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <script is:inline src={url('/admin/polyfills.js')}></script>
  </head>
  <body>
    <script>
      import CMS from '@sveltia/cms';
      CMS.init();
    </script>
  </body>
</html>
