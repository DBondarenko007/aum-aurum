---
// Small line pictograms for photo placeholders. One stroke weight, 24px grid.
interface Props { name: 'bee' | 'jar' | 'hive' | 'mountains' | 'comb' | 'hands'; size?: number }
const { name, size = 28 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'bee' && (
    <>
      <ellipse cx="12" cy="14.5" rx="3.6" ry="4.8" />
      <path d="M8.6 13h6.8M8.7 16.2h6.6" />
      <circle cx="12" cy="8.2" r="1.7" />
      <path d="M10.6 10.6C8 7 4.6 7.6 5 10s3.4 2.8 5.6 1.6M13.4 10.6C16 7 19.4 7.6 19 10s-3.4 2.8-5.6 1.6" />
      <path d="M11 6.7 9.8 5M13 6.7 14.2 5" />
    </>
  )}
  {name === 'jar' && (
    <>
      <path d="M7.5 4.5h9v2.8h-9z" />
      <path d="M8 7.3c-1.3.8-2 2-2 3.4V18a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-7.3c0-1.4-.7-2.6-2-3.4" />
      <path d="M6 12.5h12M9.5 15.5h5" />
    </>
  )}
  {name === 'hive' && (
    <>
      <path d="M3.5 9 12 4.5 20.5 9" />
      <path d="M4.5 9h15v4h-15zM5.5 13h13v7h-13z" />
      <path d="M10 17.5h4" />
    </>
  )}
  {name === 'mountains' && (
    <>
      <path d="M2.5 19.5 9 9.5l4 6 2.8-3.8 5.7 7.8z" />
      <path d="M7.4 12 9 13.3l1.5-1.3" />
      <circle cx="17.5" cy="6" r="1.6" />
    </>
  )}
  {name === 'comb' && (
    <>
      <path d="M8 3.8 11 5.5v3.4L8 10.6 5 8.9V5.5zM16 3.8l3 1.7v3.4l-3 1.7-3-1.7V5.5zM12 10.6l3 1.7v3.4l-3 1.7-3-1.7v-3.4z" />
      <path d="M12 17.4v1.4a1.2 1.2 0 1 1-2.4 0" />
    </>
  )}
  {name === 'hands' && (
    <>
      <path d="M4 14.5c1.6-1.4 3.4-1.8 5.2-.8l2.3 1.3h3a1.4 1.4 0 0 1 0 2.8H11" />
      <path d="M14.4 17.8 19 15.6a1.5 1.5 0 0 1 1.6 2.4L15.4 21H8.5L4 18.6" />
      <path d="M13 4.5 15 5.7v2.4l-2 1.2-2-1.2V5.7z" />
    </>
  )}
</svg>
