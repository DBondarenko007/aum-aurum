---
// Reviews & FAQ: published reviews, "leave a review on Google", a moderated review form
// (Web3Forms → e-mail; nothing is published automatically) and questions & answers from the admin.
interface Props {
  reviews: {
    title: string; placeholder: string; google_cta: string; write_cta: string; faq_title: string;
    form: { name: string; city: string; text: string; consent: string; submit: string; sending: string; success: string; error: string };
  };
  items: { quote: string; author: string; place: string; lang: string }[];
  faq: { q: string; a: string; hidden: boolean }[];
  googleReviewUrl?: string;
  formsKey?: string;
  lang: string;
}
const { reviews, items, faq, googleReviewUrl, formsKey, lang } = Astro.props;
const shown = items.length ? items.slice(0, 3) : [0, 1, 2].map(() => ({ quote: reviews.placeholder, author: '', place: '', lang: '' }));
const questions = faq.filter((f) => !f.hidden && f.q && f.a);
const f = reviews.form;
---
<section id="reviews" class="section dark">
  <div class="wrap">
    <div class="head">
      <h2>{reviews.title}</h2>
      <div class="actions">
        {googleReviewUrl && <a class="btn btn--gold" href={googleReviewUrl} target="_blank" rel="noopener">{reviews.google_cta}</a>}
        {formsKey && <button class="btn btn--ghost" type="button" aria-controls="review-form" aria-expanded="false" data-toggle-form>{reviews.write_cta}</button>}
      </div>
    </div>

    <ul class="quotes">
      {shown.map((r) => (
        <li>
          <blockquote lang={r.lang || undefined}><p>{r.quote}</p></blockquote>
          {(r.author || r.place) && <p class="who">{r.author}{r.place && <span>, {r.place}</span>}</p>}
        </li>
      ))}
    </ul>

    {formsKey && (
      <form id="review-form" class="form" hidden data-sending={f.sending} data-success={f.success} data-error={f.error}>
        <input type="hidden" name="access_key" value={formsKey} />
        <input type="hidden" name="subject" value={`Aum Aurum — review (${lang})`} />
        <input type="hidden" name="from_name" value="Aum Aurum website" />
        <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" autocomplete="off" />
        <label><span>{f.name}</span><input name="name" required maxlength="80" autocomplete="name" /></label>
        <label><span>{f.city}</span><input name="city" maxlength="80" /></label>
        <label class="wide"><span>{f.text}</span><textarea name="message" required rows="5" maxlength="2000"></textarea></label>
        <label class="check wide"><input type="checkbox" name="consent" value="yes" required /><span>{f.consent}</span></label>
        <div class="wide row">
          <button class="btn btn--gold" type="submit">{f.submit}</button>
          <p class="status" role="status" aria-live="polite"></p>
        </div>
      </form>
    )}

    {questions.length > 0 && (
      <div class="faq">
        <h3>{reviews.faq_title}</h3>
        {questions.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    )}
  </div>
</section>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-toggle-form]');
  const form = document.querySelector<HTMLFormElement>('#review-form');
  toggle?.addEventListener('click', () => {
    if (!form) return;
    form.hidden = !form.hidden;
    toggle.setAttribute('aria-expanded', String(!form.hidden));
    if (!form.hidden) form.querySelector('input[name="name"]')?.focus();
  });
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const status = form.querySelector('.status')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    status.textContent = form.dataset.sending!;
    button.disabled = true;
    try {
      const res = await fetch('https://api.web3forms.com/submit', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.message);
      form.reset();
      status.textContent = form.dataset.success!;
    } catch {
      status.textContent = form.dataset.error!;
    } finally {
      button.disabled = false;
    }
  });
</script>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem 1rem; }
  .quotes { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.5rem; margin: 0; padding: 0; list-style: none; }
  blockquote { margin: 0; }
  blockquote::before { content: '“'; display: block; margin-bottom: 0.6rem; font: 400 4.5rem/0.7 var(--display); color: var(--gold); }
  blockquote p { font: italic 400 clamp(1.15rem, 1rem + 0.6vw, 1.45rem)/1.5 var(--text); color: var(--cream); }
  .who { margin-top: 1rem; color: var(--gold); font: 400 15px var(--display); letter-spacing: 0.08em; }
  .who span { color: var(--cream-soft); }

  .form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
    max-width: 820px;
    margin-top: 3rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    border: 1px solid rgb(231 182 73 / 0.3);
  }
  .form[hidden] { display: none; }
  .form label { display: grid; gap: 0.4rem; font-size: 15px; color: var(--cream-soft); }
  .form .wide { grid-column: 1 / -1; }
  .form input:not([type='checkbox']), .form textarea {
    width: 100%;
    padding: 0.7rem 0.85rem;
    border: 1px solid rgb(237 225 199 / 0.3);
    background: var(--soot-2);
    color: var(--cream);
    font: inherit;
    font-size: 16px;
  }
  .form input:focus, .form textarea:focus { outline: 2px solid var(--gold); outline-offset: 1px; }
  .form .check { grid-template-columns: auto 1fr; align-items: start; gap: 0.6rem; }
  .form .check input { margin-top: 0.3rem; accent-color: var(--gold); width: 18px; height: 18px; }
  .form .row { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
  .status { color: var(--gold); font-size: 15px; }

  .faq { margin-top: clamp(3.5rem, 2.5rem + 3vw, 5rem); max-width: 900px; }
  .faq h3 { font-size: clamp(2rem, 1.4rem + 2vw, 3rem); margin-bottom: 1.5rem; color: var(--cream); }
  details { border-top: 1px solid rgb(237 225 199 / 0.15); }
  details:last-child { border-bottom: 1px solid rgb(237 225 199 / 0.15); }
  summary {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 1.25rem 0;
    font: 400 clamp(1.2rem, 1.05rem + 0.5vw, 1.5rem)/1.3 var(--display);
    color: var(--cream);
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; color: var(--gold); font-size: 1.6rem; line-height: 1; transition: rotate 0.3s var(--ease); }
  details[open] summary::after { rotate: 45deg; }
  summary:hover { color: var(--gold); }
  details p { padding: 0 0 1.5rem; max-width: 70ch; color: var(--cream-soft); }

  @media (max-width: 900px) {
    .quotes, .form { grid-template-columns: 1fr; }
  }
</style>
