---
import Mark from './Mark.astro';
import Apiary from './Apiary.astro';

interface Props {
  hero: { title: string; lead: string; cta_primary: string; cta_secondary: string; apiary_label: string; open_hive: string };
  story: { items: { number: string; text: string; hidden: boolean }[] };
  orderHref: string;
}
const { hero, story, orderHref } = Astro.props;
// Number cards under the hives: one card = number beside its text, 2–4 = a row of cards.
const cards = story.items.filter((c) => c.number.trim() && !c.hidden).slice(0, 4);
// "Aurum" in a card text is set in italics.
const parts = (t: string) => t.split(/(Aurum)/);
---
<section id="home" class="home dark">
  <div class="wrap">
    <Mark size={72} class="mark" />
    <h1>{hero.title}</h1>
    <p class="lead">{hero.lead}</p>
    <div class="actions">
      <a class="btn btn--gold" href={orderHref}>{hero.cta_primary}</a>
      <a class="btn btn--ghost" href="#location">{hero.cta_secondary}</a>
    </div>
  </div>

  <Apiary label={hero.apiary_label} openLabel={hero.open_hive} />

  <div class="wrap">
    {cards.length > 0 && (
      <ul class:list={['story', cards.length === 1 && 'story--one']} style={`--n: ${cards.length}`}>
        {cards.map((c) => (
          <li>
            <strong>{c.number}</strong>
            <p>{parts(c.text).map((p) => (p === 'Aurum' ? <em>{p}</em> : p))}</p>
          </li>
        ))}
      </ul>
    )}
  </div>
</section>

<style>
  .home { padding-top: clamp(1.25rem, 0.8rem + 1.4vw, 2.25rem); text-align: center; overflow: hidden; }
  .home :global(.mark) { width: clamp(54px, 4.6vw, 72px); height: auto; margin: 0 auto; display: block; }
  h1 {
    margin-top: 0.7rem;
    font: 500 clamp(2.1rem, 1.1rem + 3.4vw, 4.1rem)/1 var(--mark);
    letter-spacing: 0.14em;
    padding-left: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }
  .lead { margin: 0.6rem auto 1.2rem; max-width: 40ch; font-size: clamp(1rem, 0.95rem + 0.3vw, 1.2rem); }
  .actions { display: flex; justify-content: center; flex-wrap: wrap; gap: 1rem; }
  .actions .btn { min-height: 46px; padding: 0 1.4rem; font-size: 15px; }
  .story {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 1fr));
    max-width: calc(var(--n) * 270px);
    margin: 0 auto;
    padding: 1rem 0 clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
  }
  .story li { padding: 0.4rem clamp(0.9rem, 0.5rem + 1vw, 1.6rem); }
  .story li + li { border-left: 1px solid var(--soot-3); }
  .story strong { display: block; font: 400 clamp(2.2rem, 1.6rem + 2vw, 3.4rem)/1 var(--display); color: var(--gold); white-space: nowrap; }
  .story p { margin-top: 0.5rem; color: var(--cream-soft); font-size: 15px; line-height: 1.5; }
  .story em { color: var(--cream); }
  /* One card: the number beside its text, as a single line of story. */
  .story--one { max-width: 780px; }
  .story--one li { display: grid; grid-template-columns: auto 1fr; gap: 1.5rem; align-items: center; text-align: left; }
  .story--one p { margin-top: 0; font-size: 16px; line-height: 1.55; }
  @media (max-width: 900px) {
    .story:not(.story--one) { grid-template-columns: repeat(min(var(--n), 2), minmax(0, 1fr)); max-width: 560px; row-gap: 1.2rem; }
    .story:not(.story--one) li:nth-child(odd) { border-left: 0; }
    .story--one li { grid-template-columns: 1fr; gap: 0.5rem; text-align: center; }
  }
</style>
