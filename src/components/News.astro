---
import type { Locale } from '../lib/site';

interface Props {
  lang: Locale;
  title: string;
  items: { slug: string; data: { title: string; date: Date; excerpt: string; example: boolean } }[];
  ui: { all_news: string; placeholder_note: string };
  /** show all items and a page heading (news index page) */
  full?: boolean;
}
const { lang, title, items, ui, full = false } = Astro.props;
const fmt = (d: Date) => d.toLocaleDateString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric' });
const list = full ? items : items.slice(0, 3);
const Heading = full ? 'h1' : 'h2';
---
<section id="news" class="section dark news">
  <div class="wrap">
    <div class="head">
      <Heading class="title">{title}</Heading>
      {!full && <a class="all" href={`/${lang}/news/`}>{ui.all_news} →</a>}
    </div>
    <ul>
      {list.map((n) => (
        <li>
          <a href={`/${lang}/news/${n.slug}/`}>
            <time datetime={n.data.date.toISOString().slice(0, 10)}>{fmt(n.data.date)}</time>
            <div><h3>{n.data.title}</h3><p>{n.data.excerpt}</p></div>
            {n.data.example ? <span class="tag">{ui.placeholder_note}</span> : <span></span>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .title { font-family: var(--display); font-weight: 400; line-height: 1.04; font-size: clamp(2.6rem, 1.6rem + 4vw, 5.25rem); }
  .all { color: var(--gold); }
  ul { margin: 0; padding: 0; list-style: none; border-bottom: 1px solid rgb(237 225 199 / 0.15); }
  li a { display: grid; grid-template-columns: 11rem 1fr auto; gap: 2rem; align-items: baseline; padding: 1.75rem 0; border-top: 1px solid rgb(237 225 199 / 0.15); text-decoration: none; }
  li a:hover h3 { color: var(--gold); }
  time { color: var(--gold); font: 400 17px var(--display); letter-spacing: 0.08em; font-variant-numeric: tabular-nums; }
  h3 { font-size: clamp(1.5rem, 1.2rem + 1vw, 2.1rem); transition: color 0.3s; }
  p { margin-top: 0.35rem; color: var(--cream-soft); }
  .tag { border-color: rgb(237 225 199 / 0.4); color: var(--cream-soft); }
  @media (max-width: 900px) { li a { grid-template-columns: 1fr; gap: 0.4rem; } }
</style>
