---
import Photo from './Photo.astro';

interface Props {
  concept: {
    history_title: string; history_text: string; history_source: string;
    family_title: string; family_text: string;
    facts: string[];
    photos: { caption: string; image?: string | null }[];
  };
  photoSoon: string;
}
const { concept, photoSoon } = Astro.props;
const SOURCE = 'https://eurasianet.org/report-georgia-unearths-the-worlds-oldest-honey';
const looks = [
  { tone: 'olive', icon: 'hive', ratio: '3 / 4' },
  { tone: 'plum', icon: 'hands', ratio: '1 / 1' },
  { tone: 'honey', icon: 'comb', ratio: '1 / 1' },
] as const;
---
<section id="concept" class="section concept" aria-labelledby="concept-title">
  <div class="wrap">
    <div class="history">
      <h2 id="concept-title" class="h2">{concept.history_title}</h2>
      <div class="history-text">
        <p class="lead">{concept.history_text}</p>
        <a class="source" href={SOURCE} target="_blank" rel="noopener">{concept.history_source}</a>
      </div>
    </div>
  </div>

  {concept.facts.length > 0 && (
    <ul class="facts">
      {concept.facts.map((f) => <li class="label">{f}</li>)}
    </ul>
  )}

  <div class="wrap family">
    <div class="mosaic">
      {concept.photos.slice(0, 3).map((p, i) => (
        <figure class={`m m${i + 1}`}>
          <Photo image={p.image} alt={p.caption} note={photoSoon} tone={looks[i].tone} icon={looks[i].icon} ratio={looks[i].ratio} />
          <figcaption>{p.caption}</figcaption>
        </figure>
      ))}
    </div>
    <div class="family-text">
      <h3 class="h2 small">{concept.family_title}</h3>
      <p class="lead">{concept.family_text}</p>
    </div>
  </div>
</section>

<style>
  .history {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 6rem);
    align-items: start;
  }
  .history .h2 { color: var(--plum); }
  .history-text { padding-top: 0.6rem; }
  .history-text .lead { max-width: 40ch; }
  .source {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--olive);
    font-size: var(--fs-small);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin: clamp(4rem, 3rem + 4vw, 7rem) 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--rule);
  }
  .facts li {
    flex: 1 1 auto;
    padding: 1.5rem clamp(1rem, 2vw, 2rem);
    text-align: center;
    color: var(--ink);
  }
  .facts li + li { border-left: 1px solid var(--rule); }

  .family {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 6rem);
    align-items: center;
  }
  .mosaic {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    grid-template-rows: auto auto;
    gap: 1rem;
  }
  .m { margin: 0; }
  .m1 { grid-row: span 2; }
  .m figcaption { margin-top: 0.5rem; font-size: var(--fs-small); color: var(--ink-soft); }
  .family-text .small { font-size: clamp(2rem, 1.4rem + 2.2vw, 3.25rem); color: var(--plum); margin-bottom: 1.5rem; }
  .family-text .lead { max-width: 38ch; }

  @media (max-width: 860px) {
    .history, .family { grid-template-columns: 1fr; }
    .facts { justify-content: flex-start; }
    .facts li { flex: 1 1 50%; text-align: left; border-left: 0 !important; border-top: 1px solid var(--rule); }
    .facts li:first-child { border-top: 0; }
    .family-text { order: -1; }
  }
</style>
