---
// A horizontal ribbon of equal cards (three per view on desktop, swipe on phones).
// ← → arrows appear only when there are more cards than fit; they move by one card.
interface Props { prev: string; next: string; overhang?: number }
const { prev, next, overhang = 16 } = Astro.props;
---
<div class="ribbon" data-ribbon style={`--over:${overhang}px`}>
  <div class="arrows" hidden>
    <button class="arrow" type="button" data-dir="-1" aria-label={prev}>
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M11 3.5 5.5 9l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <button class="arrow" type="button" data-dir="1" aria-label={next}>
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M7 3.5 12.5 9 7 14.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
  </div>
  <div class="track"><slot /></div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-ribbon]').forEach((ribbon) => {
    const track = ribbon.querySelector<HTMLElement>('.track')!;
    const arrows = ribbon.querySelector<HTMLElement>('.arrows')!;
    const [prev, next] = arrows.querySelectorAll<HTMLButtonElement>('.arrow');
    const step = () => (track.firstElementChild as HTMLElement).getBoundingClientRect().width + parseFloat(getComputedStyle(track).columnGap);
    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      arrows.hidden = max <= 12;
      prev.disabled = track.scrollLeft <= 4;
      next.disabled = track.scrollLeft >= max - 4;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  });
</script>

<style>
  .ribbon + :global(.ribbon) { margin-top: clamp(4.5rem, 3.5rem + 3vw, 6rem); }
  .arrows { display: flex; justify-content: flex-end; gap: 0.5rem; margin-bottom: 1rem; }
  .arrows[hidden] { display: none; }
  .arrow { display: grid; place-items: center; width: 44px; height: 44px; border: 1px solid var(--soot); background: transparent; color: var(--soot); cursor: pointer; transition: background 0.3s, color 0.3s, opacity 0.3s; }
  .arrow:hover:not(:disabled) { background: var(--soot); color: var(--cream); }
  .arrow:disabled { opacity: 0.3; cursor: default; }
  .track {
    --per: 3;
    --gap: clamp(1.25rem, 2.5vw, 2.25rem);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - (var(--per) - 1) * var(--gap)) / var(--per));
    gap: var(--gap);
    align-items: stretch;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 24px var(--over) 30px;
    margin: -24px calc(var(--over) * -1) -30px;
    scroll-padding-inline: var(--over);
  }
  .track::-webkit-scrollbar { display: none; }
  .track > :global(*) { scroll-snap-align: start; }
  @media (max-width: 1100px) { .track { --per: 2.2; } }
  @media (max-width: 900px) { .track { --per: 1.2; } .arrows { display: none !important; } }
</style>
