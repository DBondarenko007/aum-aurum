---
// Gallery: polaroids pinned to two strings (four per string, three on phones).
interface Props {
  gallery: { title: string; text: string; photos: { caption: string; image?: string | null }[] };
  photoSoon: string;
}
const { gallery, photoSoon } = Astro.props;
const tones = ['#C9932E', '#6E1F2E', '#55693A', '#4D4436', '#8A7254', '#C9932E', '#14110E', '#6E1F2E'];
const slots = [
  { x: 12, y: 26, r: -5 }, { x: 37, y: 40, r: 3.5 }, { x: 62, y: 39, r: -2.5 }, { x: 87, y: 24, r: 5 },
  { x: 16, y: 22, r: 4 }, { x: 41, y: 38, r: -3 }, { x: 66, y: 40, r: 2 }, { x: 90, y: 26, r: -4.5 },
];
const photos = gallery.photos.slice(0, 8);
const strands = [photos.slice(0, 4), photos.slice(4, 8)].filter((s) => s.length);
const curves = ['M-2 4 Q50 20 102 3', 'M-2 3 Q50 21 102 5'];
---
<section id="gallery" class="section paper gallery">
  <div class="wrap">
    <div class="head"><h2>{gallery.title}</h2><p>{gallery.text}</p></div>
    {strands.map((strand, s) => (
      <div class="strand">
        <svg class="string" viewBox="0 0 100 30" preserveAspectRatio="none" aria-hidden="true"><path d={curves[s]} /></svg>
        {strand.map((p, j) => {
          const i = s * 4 + j;
          const slot = slots[i];
          return (
            <figure class="pol" style={`--x:${slot.x}%;--y:${slot.y}px;--r:${slot.r}deg;--d:${(-i * 0.85).toFixed(2)}s`}>
              <span class="pin" aria-hidden="true"></span>
              {p.image
                ? <img class="ph" src={p.image} alt={p.caption} loading="lazy" />
                : <div class="ph" style={`background:${tones[i]}`}>{photoSoon}</div>}
              <figcaption>{p.caption}</figcaption>
            </figure>
          );
        })}
      </div>
    ))}
  </div>
</section>

<style>
  .gallery { overflow: hidden; }
  .strand { position: relative; height: clamp(300px, 26vw, 360px); }
  .strand + .strand { margin-top: 1rem; }
  .string { position: absolute; inset: 0 0 auto; width: 100%; height: 90px; overflow: visible; }
  .string path { fill: none; stroke: var(--soot); stroke-width: 1.2; vector-effect: non-scaling-stroke; opacity: 0.55; }
  .pol {
    --w: clamp(150px, 15vw, 210px);
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--w);
    margin: 0;
    padding: 10px 10px 0;
    background: #fff;
    box-shadow: 0 22px 34px -20px rgb(20 17 14 / 0.55), 0 2px 4px rgb(20 17 14 / 0.12);
    translate: -50% 0;
    rotate: var(--r);
    transform-origin: 50% -12px;
    animation: sway 7s ease-in-out var(--d) infinite alternate;
    transition: scale 0.5s var(--ease);
  }
  .pol:hover { scale: 1.06; animation-play-state: paused; z-index: 2; }
  .ph { display: grid; place-items: center; width: 100%; aspect-ratio: 4 / 5; object-fit: cover; color: var(--cream); font-size: 13px; }
  figcaption { padding: 0.55rem 0 0.75rem; text-align: center; font: 400 16px var(--display); letter-spacing: 0.04em; }
  .pin {
    position: absolute;
    top: -15px;
    left: 50%;
    width: 11px;
    height: 30px;
    translate: -50% 0;
    border-radius: 2px;
    background: linear-gradient(90deg, #b48c3a 0 46%, #8f6d2a 46% 54%, #c9a24f 54%);
    box-shadow: 0 2px 3px rgb(0 0 0 / 0.3);
  }
  @keyframes sway { from { rotate: var(--r); } to { rotate: calc(var(--r) * -0.4); } }
  @media (prefers-reduced-motion: reduce) { .pol { animation: none; } }
  @media (max-width: 900px) {
    .strand { height: 250px; }
    .pol { --w: 30vw; padding: 6px 6px 0; }
    .pol:nth-of-type(4) { display: none; }
    .pol:nth-of-type(1) { left: 17%; }
    .pol:nth-of-type(2) { left: 50%; }
    .pol:nth-of-type(3) { left: 83%; }
    figcaption { font-size: 13px; }
  }
</style>
