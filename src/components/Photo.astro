---
import Icon from './Icon.astro';

type Tone = 'olive' | 'plum' | 'honey' | 'ink' | 'paper';
interface Props {
  image?: string | null;
  alt?: string;
  note?: string;
  tone?: Tone;
  icon?: 'bee' | 'jar' | 'hive' | 'mountains' | 'comb' | 'hands';
  ratio?: string;
  class?: string;
}
const { image, alt = '', note = '', tone = 'olive', icon = 'bee', ratio = '4 / 5', class: cls = '' } = Astro.props;
---
{image ? (
  <img class:list={['photo', cls]} src={image} alt={alt} loading="lazy" decoding="async" style={`aspect-ratio:${ratio}`} />
) : (
  <div class:list={['photo', 'photo--empty', `tone-${tone}`, cls]} style={`aspect-ratio:${ratio}`} role="img" aria-label={alt || note}>
    <Icon name={icon} size={30} />
    {note && <span>{note}</span>}
  </div>
)}

<style>
  .photo { width: 100%; object-fit: cover; }
  .photo--empty {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    padding: 1rem;
    text-align: center;
    font-size: 0.8125rem;
    line-height: 1.3;
  }
  /* Each tone keeps its note at >= 4.5:1. */
  .tone-olive { background: var(--olive-deep); color: var(--blush); }
  .tone-plum { background: var(--plum-deep); color: var(--blush); }
  .tone-honey { background: var(--honey); color: var(--ink); }
  .tone-ink { background: var(--ink-2); color: var(--blush-soft); outline: 1px solid #2c2a27; outline-offset: -1px; }
  .tone-paper { background: #efe0e1; color: var(--plum); }
</style>
