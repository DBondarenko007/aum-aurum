---
interface Props {
  location: {
    title: string; text: string; address: string; hours: string; visit_note: string;
    route_cta: string; stops: string[]; here: string;
  };
  lat?: number;
  lng?: number;
  call?: { href: string; label: string } | null;
}
const { location, lat = 41.9818, lng = 44.741, call } = Astro.props;
const route = `https://www.google.com/maps/dir/?api=1&destination=${lat},${lng}`;
const HERE = 2; // index of Navazi in `stops`
---
<section id="location" class="section olive" aria-labelledby="location-title">
  <div class="wrap">
    <div class="top">
      <h2 id="location-title" class="h2 title">{location.title}</h2>
      <div class="info">
        <p class="lead">{location.text}</p>
        <address>
          <span>{location.address}</span>
          <span>{location.hours}</span>
          <span>{location.visit_note}</span>
        </address>
        <div class="actions">
          <a class="btn btn--honey" href={route} target="_blank" rel="noopener">{location.route_cta}</a>
          {call && <a class="btn" href={call.href}>{call.label}</a>}
        </div>
      </div>
    </div>

    <ol class="route" style={`--here:${HERE};--count:${location.stops.length}`}>
      {location.stops.map((stop, i) => (
        <li class:list={{ here: i === HERE, passed: i < HERE }} aria-current={i === HERE ? 'location' : undefined}>
          <span class="dot" aria-hidden="true">
            {i === HERE && (
              <svg width="34" height="46" viewBox="-14 -12 28 40"><polygon points="12,0 6,10.39 -6,10.39 -12,0 -6,-10.39 6,-10.39" /><path transform="translate(0 13)" d="M0,0 C3,5 6,8 6,11 A6,6 0 1 1 -6,11 C-6,8 -3,5 0,0Z" /></svg>
            )}
          </span>
          <span class="name">{stop}</span>
          {i === HERE && <span class="label you">{location.here}</span>}
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  // The honey dot drives up the road once, when the route scrolls into view.
  const route = document.querySelector('.route');
  if (route && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { route.classList.add('go'); io.disconnect(); }
    }, { threshold: 0.6 });
    io.observe(route);
  } else route?.classList.add('go');
</script>

<style>
  .top {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 6rem);
  }
  .title { color: var(--honey); }
  .info { display: flex; flex-direction: column; gap: 1.5rem; padding-top: 0.6rem; }
  address { display: flex; flex-direction: column; gap: 0.25rem; font-style: normal; }
  address span:first-child { font-weight: 500; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem 1rem; }

  /* The road: Tbilisi → Stepantsminda */
  .route {
    --line: color-mix(in oklab, var(--blush) 55%, transparent);
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--count), minmax(0, 1fr));
    margin: clamp(4rem, 3rem + 4vw, 6.5rem) 0 0;
    padding: 0;
    list-style: none;
  }
  .route::before, .route::after {
    content: '';
    position: absolute;
    top: 22px;
    left: calc(50% / var(--count));
    height: 2px;
  }
  .route::before { right: calc(50% / var(--count)); background: var(--line); }
  /* honey road up to Navazi */
  .route::after {
    width: calc(100% / var(--count) * var(--here));
    background: var(--honey);
    transform-origin: left;
    transform: scaleX(0);
  }
  .route.go::after { transform: scaleX(1); transition: transform 1.8s var(--ease-out) 0.2s; }
  @media (prefers-reduced-motion: reduce) { .route::after { transform: none; } }

  .route li { position: relative; display: flex; flex-direction: column; align-items: center; gap: 0.9rem; text-align: center; }
  .dot {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
  }
  .dot::before {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--olive);
    box-shadow: 0 0 0 2px var(--blush);
  }
  .passed .dot::before { box-shadow: 0 0 0 2px var(--honey); }
  .here .dot::before { display: none; }
  .here svg { fill: var(--honey); position: relative; z-index: 1; translate: 0 -6px; }
  .name { font-size: var(--fs-small); }
  .here .name { font-size: var(--fs-h3); font-weight: 400; color: var(--honey); line-height: 1.1; }
  .you { color: var(--blush); }

  @media (max-width: 860px) {
    .top { grid-template-columns: 1fr; }
    .route { grid-template-columns: 1fr; gap: 0; }
    .route::before, .route::after { top: 23px; bottom: 23px; left: 22px; right: auto; width: 2px; height: auto; }
    .route::after { height: calc(100% / var(--count) * var(--here)); bottom: auto; transform: scaleY(0); transform-origin: top; }
    .route.go::after { transform: scaleY(1); }
    .route li { flex-direction: row; align-items: center; text-align: left; gap: 1rem; min-height: 56px; }
    .you { margin-left: auto; }
  }
</style>
