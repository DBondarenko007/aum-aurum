---
// Shop on the home page: honey varieties as hive frames, then one ribbon of hive-body cards for
// everything else (bee colonies, hives, other). Both ribbons get arrows when they hold more than three.
import HoneyFrame from './HoneyFrame.astro';
import HiveCard from './HiveCard.astro';
import Ribbon from './Ribbon.astro';
import { messageLink, url, type Locale, type ProductEntry } from '../lib/site';

interface Props {
  shop: {
    title: string; subtitle: string; starter_title: string; starter_parts: string[]; starter_cta: string;
    add_to_cart: string; added: string; preorder: string; order: string; message: string;
    all_products: string; prev: string; next: string;
    badges: Record<string, string>; categories: Record<string, string>;
  };
  products: ProductEntry[];
  ui: { photo_soon: string; price_on_request: string };
  lang: Locale;
  site: Record<string, any>;
  contactHref: string;
}
const { shop, products, ui, lang, site, contactHref } = Astro.props;
const visible = products.filter((p) => p.data.available);
const honey = visible.filter((p) => p.data.category === 'honey');
const rest = visible.filter((p) => p.data.category !== 'honey');
const labels = { ...shop, price_on_request: ui.price_on_request, photo_soon: ui.photo_soon };
const msg = (p: ProductEntry) => messageLink(site, `${shop.message} ${p.data.title}`, contactHref);
---
<section id="shop" class="section paper">
  <div class="wrap">
    <div class="head">
      <h2>{shop.title}</h2>
      <div class="intro">
        <p>{shop.subtitle}</p>
        <a class="all" href={url(`/${lang}/shop/`)}>{shop.all_products} →</a>
      </div>
    </div>

    {honey.length > 0 && (
      <Ribbon prev={shop.prev} next={shop.next} overhang={16}>
        {honey.map((p) => <HoneyFrame product={p} lang={lang} labels={labels} />)}
      </Ribbon>
    )}

    {rest.length > 0 && (
      <Ribbon prev={shop.prev} next={shop.next} overhang={10}>
        {rest.map((p) => <HiveCard product={p} lang={lang} labels={labels} message={msg(p)} />)}
      </Ribbon>
    )}

    <div class="starter">
      <strong>{shop.starter_title} <span>{shop.starter_parts.join(' + ')}</span></strong>
      <a class="btn btn--gold" href={contactHref}>{shop.starter_cta}</a>
    </div>
  </div>
</section>

<script>
  import '../scripts/add-buttons';
</script>

<style>
  .intro { display: grid; gap: 0.75rem; justify-items: start; max-width: 36ch; }
  .intro p { color: var(--ink-soft); }
  .all { color: var(--wine); font-size: 1.0625rem; }
  .starter {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
    align-items: center;
    justify-content: space-between;
    margin-top: clamp(3rem, 2rem + 3vw, 4.5rem);
    padding: 1.75rem 2.25rem;
    background: var(--soot);
    color: var(--cream);
  }
  .starter strong { font: 400 clamp(1.5rem, 1rem + 1.6vw, 2.4rem)/1.1 var(--display); }
  .starter strong span { color: var(--gold); }
  @media (max-width: 900px) { .starter { padding: 1.5rem; } }
</style>
