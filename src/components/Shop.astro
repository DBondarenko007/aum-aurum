---
// Shop: products as hive frames (wood frame, black top bar with lugs, comb photo slot).
interface Product { slug: string; data: { category: string; title: string; size: string; price: string; available: boolean } }
interface Props {
  shop: {
    title: string; subtitle: string;
    honey_title: string; honey_image?: string | null;
    colonies_title: string; colonies_text: string; colonies_cta: string; colonies_image?: string | null;
    hives_title: string; hives_text: string; hives_cta: string; hives_image?: string | null;
    starter_title: string; starter_parts: string[]; starter_cta: string;
  };
  products: Product[];
  ui: { photo_soon: string; price_on_request: string; order_honey: string };
  orderHref: string;
  contactHref: string;
}
const { shop, products, ui, orderHref, contactHref } = Astro.props;
const honey = products.filter((p) => p.data.category === 'honey' && p.data.available);
---
<section id="shop" class="section paper">
  <div class="wrap">
    <div class="head"><h2>{shop.title}</h2><p>{shop.subtitle}</p></div>

    <div class="frames">
      <article class="frame">
        <div class="bar"></div>
        <div class="cell">
          {shop.honey_image ? <img class="photo" src={shop.honey_image} alt={shop.honey_title} loading="lazy" /> : <div class="comb"><span>{ui.photo_soon}</span></div>}
          <h3>{shop.honey_title}</h3>
          {honey.length > 0 && (
            <ul class="prices">
              {honey.map((p) => (
                <li><span>{p.data.title}{p.data.size && `, ${p.data.size}`}</span><span class="dots" aria-hidden="true"></span><span>{p.data.price || ui.price_on_request}</span></li>
              ))}
            </ul>
          )}
          <a class="btn btn--ink" href={orderHref}>{ui.order_honey}</a>
        </div>
      </article>

      <article class="frame">
        <div class="bar"></div>
        <div class="cell">
          {shop.colonies_image ? <img class="photo" src={shop.colonies_image} alt={shop.colonies_title} loading="lazy" /> : <div class="comb"><span>{ui.photo_soon}</span></div>}
          <h3>{shop.colonies_title}</h3>
          <p>{shop.colonies_text}</p>
          <a class="btn btn--line" href={contactHref}>{shop.colonies_cta}</a>
        </div>
      </article>

      <article class="frame">
        <div class="bar"></div>
        <div class="cell">
          {shop.hives_image ? <img class="photo" src={shop.hives_image} alt={shop.hives_title} loading="lazy" /> : <div class="comb"><span>{ui.photo_soon}</span></div>}
          <h3>{shop.hives_title}</h3>
          <p>{shop.hives_text}</p>
          <a class="btn btn--line" href={contactHref}>{shop.hives_cta}</a>
        </div>
      </article>
    </div>

    <div class="starter">
      <strong>{shop.starter_title} <span>{shop.starter_parts.join(' + ')}</span></strong>
      <a class="btn btn--gold" href={contactHref}>{shop.starter_cta}</a>
    </div>
  </div>
</section>

<style>
  .frames { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: clamp(1.25rem, 2.5vw, 2.25rem); align-items: start; padding-top: 14px; }
  .frame {
    position: relative;
    padding: 0 12px 12px;
    background: var(--wood);
    box-shadow: 0 10px 20px -16px rgb(20 17 14 / 0.6);
    transition: transform 0.55s var(--ease), box-shadow 0.55s var(--ease);
  }
  .frame:hover { transform: translateY(-16px); box-shadow: 0 30px 40px -24px rgb(20 17 14 / 0.55); }
  .bar { height: 20px; margin: 0 -30px 12px; background: var(--soot); border-radius: 3px; }
  .cell { display: grid; gap: 0.9rem; padding: 1.5rem; background: var(--paper-2); }
  h3 { font-size: clamp(2rem, 1.4rem + 1.6vw, 2.9rem); }
  :lang(ka) h3 { font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.3rem); }
  .comb, .photo { aspect-ratio: 4 / 3; width: 100%; object-fit: cover; }
  .comb {
    display: grid;
    place-items: center;
    background-color: #f2c75c;
    background-image: radial-gradient(circle, var(--gold-deep) 0 30%, transparent 32%);
    background-size: 24px 21px;
    font-size: 14px;
  }
  .comb span { background: var(--paper-2); padding: 0.15rem 0.7rem; border-radius: 999px; }
  .prices { margin: 0; padding: 0; list-style: none; font-variant-numeric: tabular-nums; }
  .prices li { display: flex; gap: 0.7rem; align-items: baseline; padding: 0.55rem 0; border-bottom: 1px solid rgb(20 17 14 / 0.15); }
  .dots { flex: 1; min-width: 0.5rem; border-bottom: 1px dotted rgb(20 17 14 / 0.4); }
  .prices li > span:first-child, .prices li > span:last-child { white-space: nowrap; }
  .cell .btn { justify-self: start; min-height: 46px; font-size: 14px; }
  .starter {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem 2rem;
    align-items: center;
    justify-content: space-between;
    margin-top: 3.5rem;
    padding: 1.75rem 2.25rem;
    background: var(--soot);
    color: var(--cream);
  }
  .starter strong { font: 400 clamp(1.5rem, 1rem + 1.6vw, 2.4rem)/1.1 var(--display); }
  .starter strong span { color: var(--gold); }
  @media (max-width: 900px) {
    .frames { grid-template-columns: 1fr; }
    .bar { margin: 0 -14px 12px; }
    .starter { padding: 1.5rem; }
  }
  @media (max-width: 560px) {
    .prices li { flex-wrap: wrap; row-gap: 0.1rem; }
    .prices li > span:first-child { flex: 1 0 100%; white-space: normal; }
  }
</style>
