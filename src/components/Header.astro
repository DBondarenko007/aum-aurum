---
import Mark from './Mark.astro';
import { LOCALES, LOCALE_LABEL, LOCALE_NAME, url, type Locale } from '../lib/site';

interface Props {
  lang: Locale;
  nav: Record<'home' | 'shop' | 'location' | 'news' | 'reviews' | 'gallery', string>;
  ui: { menu: string; close: string; language: string; to_top: string; cart: string };
  /** path after the locale for the language switcher, e.g. "" or "news/welcome/" */
  path?: string;
  /** anchors point to the home page when rendered on a sub-page */
  home?: boolean;
}
const { lang, nav, ui, path = '', home = true } = Astro.props;
const items = ['home', 'shop', 'news', 'location', 'reviews', 'gallery'] as const;
const href = (id: string) => (home ? `#${id}` : url(`/${lang}/#${id}`));
---
<header class="site-header">
  <div class="bar">
    <a class="brand" href={href('home')} aria-label={ui.to_top}><Mark size={30} /></a>

    <nav class="nav" id="site-nav" aria-label="Main">
      <ul class="links">
        {items.map((id) => <li><a href={href(id)}>{nav[id]}</a></li>)}
      </ul>
      <ul class="langs" aria-label={ui.language}>
        {LOCALES.map((l) => (
          <li>
            <a href={url(`/${l}/${path}`)} hreflang={l} lang={l} title={LOCALE_NAME[l]} data-lang={l}
               aria-current={l === lang ? 'true' : undefined}>{LOCALE_LABEL[l]}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="cart-link" href={url(`/${lang}/cart/`)} aria-label={ui.cart} title={ui.cart}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M3.5 8.5h17l-1.6 10.2a2 2 0 0 1-2 1.8H7.1a2 2 0 0 1-2-1.8z" />
        <path d="M8.5 8.5 11 3.5M15.5 8.5 13 3.5M9 12.5v4M12 12.5v4M15 12.5v4" />
      </svg>
      <span class="count" hidden>0</span>
    </a>

    <button class="menu-btn" type="button" aria-controls="site-nav" aria-expanded="false" data-open={ui.menu} data-close={ui.close}>
      <span class="menu-icon" aria-hidden="true"></span>
      <span class="menu-text">{ui.menu}</span>
    </button>
  </div>
</header>

<script>
  import { cartCount } from '../scripts/cart';

  const count = document.querySelector<HTMLElement>('.cart-link .count');
  const showCount = () => {
    if (!count) return;
    const n = cartCount();
    count.textContent = String(n);
    count.hidden = n === 0;
  };
  showCount();
  window.addEventListener('cart:change', showCount);
  window.addEventListener('storage', showCount);

  const btn = document.querySelector<HTMLButtonElement>('.menu-btn');
  const nav = document.getElementById('site-nav');
  const setOpen = (open: boolean) => {
    if (!btn || !nav) return;
    btn.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('is-open', open);
    btn.querySelector('.menu-text')!.textContent = open ? btn.dataset.close! : btn.dataset.open!;
  };
  btn?.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
  nav?.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a');
    if (!a) return;
    if (a.dataset.lang) {
      try { localStorage.setItem('aa-lang', a.dataset.lang); } catch {}
    }
    setOpen(false);
  });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setOpen(false); });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(20 17 14 / 0.96);
    border-bottom: 1px solid rgb(231 182 73 / 0.18);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: var(--header-h);
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
  .brand { flex: none; display: block; line-height: 0; }
  .nav { flex: 1; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .nav ul { display: flex; flex-wrap: wrap; gap: 0.25rem 1.7rem; margin: 0; padding: 0; list-style: none; }
  .links a {
    font: 400 16px var(--display);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--cream-soft);
    transition: color 0.3s;
  }
  :lang(ka) .links a { text-transform: none; letter-spacing: 0.02em; }
  .links a:hover { color: var(--gold); }
  .langs { gap: 0.9rem !important; }
  .langs a { font-size: 15px; color: var(--cream-soft); }
  .langs a[aria-current='true'] { color: var(--gold); text-decoration: none; }

  .cart-link {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--cream);
    transition: color 0.3s;
  }
  .cart-link:hover { color: var(--gold); }
  .count {
    position: absolute;
    top: 2px;
    right: 0;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 9px;
    background: var(--gold);
    color: var(--soot);
    font: 700 11px/18px var(--text);
    text-align: center;
  }
  .count[hidden] { display: none; }
  .menu-btn {
    display: none;
    align-items: center;
    gap: 0.6rem;
    min-height: 44px;
    padding: 0 0.25rem;
    border: 0;
    background: none;
    color: var(--cream);
    font: 400 16px var(--display);
    letter-spacing: 0.08em;
    cursor: pointer;
  }
  .menu-icon, .menu-icon::before { display: block; width: 22px; height: 1.5px; background: currentColor; transition: transform 0.3s var(--ease); }
  .menu-icon { position: relative; box-shadow: 0 -6px 0 currentColor; transform: translateY(3px); }
  .menu-icon::before { content: ''; position: absolute; top: 6px; }
  .menu-btn[aria-expanded='true'] .menu-icon { box-shadow: none; transform: rotate(45deg); }
  .menu-btn[aria-expanded='true'] .menu-icon::before { top: 0; transform: rotate(-90deg); }

  @media (max-width: 960px) {
    .menu-btn { display: inline-flex; }
    .cart-link { margin-left: auto; }
    .nav {
      position: absolute;
      inset: var(--header-h) 0 auto 0;
      display: none;
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
      padding: 1.25rem var(--gutter) 2rem;
      background: var(--soot);
      border-bottom: 1px solid rgb(231 182 73 / 0.18);
    }
    .nav.is-open { display: flex; }
    .links { flex-direction: column; gap: 0 !important; }
    .links a { display: block; padding: 0.7rem 0; font-size: 20px; }
  }
</style>
